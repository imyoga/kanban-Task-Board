# Server
NODE_ENV=development
API_PORT=5000
PORT=5000

# Frontend (Vite)
BASE_PATH=/

# PostgreSQL connection string
# Example for ems-fullstack-postgres-local: postgresql://ems_local:PASSWORD@localhost:5432/kanban
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kanban

# Session cookie signing secret (change in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional logging
LOG_LEVEL=info
