# Server
NODE_ENV=development
PORT=5000

# Frontend (Vite)
BASE_PATH=/

# PostgreSQL connection string
# Example for ems-fullstack-postgres-local: postgresql://ems_local:PASSWORD@localhost:5432/kanban
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kanban

# Session cookie signing secret (change in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional logging
LOG_LEVEL=info

# Frontend origin for invite links
CLIENT_ORIGIN=http://localhost:5173

# Email (Gmail SMTP)
SMTP_USER=
SMTP_FROM="Kanban <your-email@gmail.com>"
GOOGLE_APP_PASSWORD=
